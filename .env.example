# ============================================================================
# Orchestrix - environment configuration
# Copy to .env and fill in. Every variable the code reads is listed here.
# ============================================================================

# ── Required ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Who may use the Telegram bot (comma-separated Telegram user ids).
# Message @userinfobot on Telegram to find yours. If empty, TELEGRAM_CHAT_ID
# is used. The bot refuses to start with nobody allowed.
TELEGRAM_ALLOWED_USER_IDS=
# Chat that receives the daily briefing.
TELEGRAM_CHAT_ID=
# DANGER: lets anyone who finds the bot read your mail and control your phone.
TELEGRAM_ALLOW_ALL=false

# ── Optional API keys ───────────────────────────────────────────────────────
OPENWEATHER_API_KEY=
# Bearer token for the HTTP API (app/api.py). Without it, only localhost may call it.
ORCHESTRIX_API_TOKEN=

# ── Models ──────────────────────────────────────────────────────────────────
DEFAULT_MODEL=local                    # local | api
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3:8b-instruct-q4_K_M
OLLAMA_NUM_GPU=20                      # layers offloaded to the GPU
GEMINI_MODEL=models/gemini-flash-latest
API_QUOTA_FALLBACK_TO_LOCAL=true       # Gemini quota hit -> answer locally
ENABLE_LLM_TOOL_ROUTING=true           # API mode: let Gemini pick read-only tools

# ── Feature toggles ─────────────────────────────────────────────────────────
ENABLE_WEB_SEARCH=true
ENABLE_VOICE=true
ENABLE_PDF_RAG=true
ENABLE_PHONE_ADB=true
ENABLE_RESEARCH_TRACE=true             # write research/logs/orchestration_trace.jsonl
ALLOW_PRIVATE_URLS=false               # let URL tools fetch localhost/LAN addresses

# ── Rate limits (requests per minute) ───────────────────────────────────────
GEMINI_RATE_LIMIT=60
WEB_SEARCH_RATE_LIMIT=30
MAPS_RATE_LIMIT=50
NEWS_RATE_LIMIT=30

# ── Locale ──────────────────────────────────────────────────────────────────
TIMEZONE=Asia/Kolkata
DEFAULT_CITY=Hyderabad
DEFAULT_LAT=17.385
DEFAULT_LON=78.4867
DAILY_BRIEFING_HOUR=8

# ── Paths & logging ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
ORCHESTRIX_DATA_DIR=data               # SQLite DB, per-user PDFs and indexes
GOOGLE_CREDENTIALS_DIR=credentials     # credentials.json + token.json

# ── Optional system tools (Windows paths shown) ─────────────────────────────
FFMPEG_DIR=
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
POPPLER_PATH=
