data/
memory/
logs/
reports/
pdfs/
config/*.json
*.log

# ── RAG index artifacts ───────────────────────────────────────────────────
rag/chunks.json
*.faiss
*.index
*.pkl

# ── Research run output (curated results go in research/results/) ────────
research/logs/
research/graphs/
research/results_*.json
*.jsonl

# ── Media / temp ──────────────────────────────────────────────────────────
*.ogg
*.mp3
*.wav
*.pdf

# ── Editors / OS ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~
.DS_Store
